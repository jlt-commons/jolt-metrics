{:paths ["src" "resources"]

 ;; the HTML report inlines resources/metrics/html, so the binary carries it
 :jolt/build {:embed ["resources"]}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.jlt-commons/writ
                       {:git/url "https://github.com/jlt-commons/writ"
                        :git/sha "11ea31dfd4f261332df3b227c37c962e30eefb4e"}}
         :main-opts   ["-m" "metrics.runner"]}
  ;; a writ checkout next to this one (../writ), for iterating on specs
  ;; without a fetch: jolt -M:test:dev
  :dev {:override-deps {io.github.jlt-commons/writ
                        {:local/root "../writ"}}}}}
