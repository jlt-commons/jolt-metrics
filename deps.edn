{:jolt/min-version "0.8.25"
 :paths ["src" "resources"]

 ;; the HTML report inlines resources/metrics/html, so the binary carries it
 :jolt/build {:embed ["resources"]}

 ;; the index behind the call-graph metrics: resolved references between vars
 :deps {io.github.jlt-commons/jolt-lsp
        {:git/url "https://github.com/jlt-commons/jolt-lsp"
         :git/tag "v0.6.1"
         :git/sha "86f85aa8ce7c88456fb8d13bf1bfc843260faea4"}}

 :tasks
 {dist  {:doc "build the standalone jolt-lsp binary"
         :task (shell "jolt" "build" "-m" "metrics.cli" "-o" "target/jolt-metrics")}}
 
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.jlt-commons/writ
                       {:git/url "https://github.com/jlt-commons/writ"
                        :git/tag "v0.1.16"
                        :git/sha "4619c7a8144b4214072f47a5cec1f15579acabe7"}}
         :main-opts   ["-m" "metrics.runner"]}
  ;; a writ checkout next to this one (../writ), for iterating on specs
  ;; without a fetch: jolt -M:test:dev
  :dev {:override-deps {io.github.jlt-commons/writ
                        {:local/root "../writ"}}}}}
